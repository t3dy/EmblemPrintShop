.DS_Store
Thumbs.db
__pycache__/
*.pyc
.venv/
node_modules/
dist/
build/
.env
.env.*

# Large binary asset directories — not tracked in git
# Run the extraction pipeline locally to regenerate
assets/extracted/
assets/extracted_all/

# Raw source image archives (multi-GB)
sources/*/images/
sources/*/site/images/

# Emblem Knight game: generated cache + regenerable QA artifacts
game/tools/.cast_index.json
game/_curation/*.png
game/_curation/*.jpg
game/assets/sprites/_SHEET.png

# Runtime logs
*.log
logs/

# Pytest cache
.pytest_cache/

# Live review-queue state (prototype/serve.py's /api/save-review) — per-
# reviewer working state, not curated data; commit review outcomes via
# build_object_catalog.py / data/emblems.json instead, once a review pass
# is done.
prototype/review_decisions.json

# Memory files (local only)
.claude/
